# Servora Web — environment variables
#
# Copy this file to .env.local for local overrides:
#   cp .env.example .env.local
#
# Nothing here is required — every value has a safe default (see
# src/lib/env.ts) and the app runs entirely on local mock data
# (src/data/) with zero configuration.
#
# Only NEXT_PUBLIC_-prefixed variables belong in this file. Anything
# without that prefix would be server-only and must never hold a secret
# that also needs client access — Next.js inlines NEXT_PUBLIC_* values
# into the browser bundle at build time, so never put credentials, API
# keys, or tokens behind that prefix.

# Public site origin, used for absolute URLs in metadata (Open Graph,
# canonical links). Defaults to the production domain when unset.
NEXT_PUBLIC_SITE_URL=https://servora.hemandu.com

# Reserved for when this frontend starts calling the real Servora API
# Gateway. Not read anywhere in the codebase yet — left commented out
# on purpose so an unset value can't be mistaken for a working backend.
# NEXT_PUBLIC_API_BASE_URL=https://api.servora.hemandu.com
