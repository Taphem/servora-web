# Version control
.git
.gitignore

# Dependencies (installed fresh inside the image via npm ci)
node_modules

# Build output (produced inside the image)
.next
out
build

# Env files — never bake secrets into an image layer
.env
.env.local
.env.*.local

# Docker itself
Dockerfile
.dockerignore
docker-compose*.yml

# CI / tooling not needed at runtime
.github

# Editor / OS metadata
.vscode
.idea
.DS_Store
*.swp
*.swo

# Logs and caches
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.tsbuildinfo

# Docs not needed inside the runtime image
README.md

# This session's local tooling config
.claude
